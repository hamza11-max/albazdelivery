{
  "name": "@albaz/pos",
  "version": "0.0.1",
  "private": true,
  "description": "AL-baz POS - Phase 2 spike: Arabic/French receipt printing and cash drawer",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "start": "npm run build && electron .",
    "selftest": "npm run build && electron . --selftest",
    "test": "npm run build && node --test dist/escpos.test.js",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "devDependencies": {
    "electron": "39.8.6",
    "typescript": "^5.9.3"
  }
}
