    "test": "cross-env NODE_ENV=test jest --config ../../jest.config.ts",
    "test:watch": "cross-env NODE_ENV=test jest --config ../../jest.config.ts --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --config ../../jest.config.ts --coverage"
  },
  "dependencies": {
    "@albaz/shared": "*",
    "@albaz/ui": "*",
    "@albaz/auth": "*",
    "next": "^16.0.7",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "lucide-react": "^1.33.0",
    "tailwind-merge": "^3.6.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5"
  }
}