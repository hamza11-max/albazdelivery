{
  "name": "albazdelivery-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0 <24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "type-check": "tsc --noEmit",
    "type-check:vendor": "npm run type-check -w @albaz/vendor",
    "build:vendor:desktop:restaurant": "npm run electron:build:win:restaurant -w @albaz/vendor",
    "build:vendor:desktop:retail": "npm run electron:build:win:retail -w @albaz/vendor",
    "build:vendor:desktop:grocery": "npm run electron:build:win:grocery -w @albaz/vendor",
    "build:vendor:desktop:other": "npm run electron:build:win:other -w @albaz/vendor",
    "build:vendor:desktop:all-verticals": "npm run electron:build:win:all-verticals -w @albaz/vendor",
    "clean": "turbo run clean",
    "vercel-build": "node -e \"const fs=require('fs');['.next','app/customer/.next'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}});\" && prisma generate --schema=./prisma/schema.prisma && next build --webpack",
    "vercel-build:with-migrate": "node -e \"const fs=require('fs');['.next','app/customer/.next'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}});\" && prisma generate --schema=./prisma/schema.prisma && prisma migrate deploy --schema=./prisma/schema.prisma && next build --webpack",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma || exit 0; node scripts/sync-customer-copy-to-mobile.js",
    "prepare": "prisma generate --schema=./prisma/schema.prisma || exit 0",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:generate": "cross-env NODE_ENV=development prisma generate --schema=./prisma/schema.prisma",
    "db:push": "cross-env NODE_ENV=development prisma db push",
    "db:migrate": "cross-env NODE_ENV=development prisma migrate deploy",
    "db:migrate:dev": "cross-env NODE_ENV=development prisma migrate dev",
    "db:migrate:deploy": "cross-env NODE_ENV=development prisma migrate deploy",
    "db:studio": "node scripts/start-prisma-studio.js",
    "db:seed": "cross-env NODE_ENV=development node -r @swc/register prisma/seed.ts",
    "db:create-admin": "cross-env NODE_ENV=development tsx scripts/create-admin-user.ts",
    "test": "cross-env NODE_ENV=test jest --config jest.config.ts",
    "test:api": "cross-env NODE_ENV=test jest --ci --config jest.config.ts --selectProjects api --maxWorkers=2",
    "test:jest-ui": "cross-env NODE_ENV=test jest --config jest.config.ts --selectProjects ui --maxWorkers=2",
    "test:watch": "cross-env NODE_ENV=test jest --config jest.config.ts --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.ts --coverage",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.config.ts --testMatch \"**/__tests__/**/*.test.ts?(x)\"",
    "test:e2e": "playwright test tests-e2e/",
    "test:e2e:ui": "playwright test tests-e2e/ --ui",
    "test:e2e:debug": "playwright test tests-e2e/ --debug",
    "test:ci": "cross-env NODE_ENV=test npm run test:api -- --coverage --coverageDirectory=coverage-api && cross-env NODE_ENV=test npm run test:jest-ui -- --ci --coverage --coverageDirectory=coverage-ui --maxWorkers=2 && playwright test tests-e2e/",
    "sync:customer-copy": "node scripts/sync-customer-copy-to-mobile.js",
    "check:rate-limit": "node scripts/verify-apply-rate-limit-await.mjs .",
    "verify:api": "npm run check:rate-limit && npm run test:api",
    "verify:phase-a": "npm run type-check && npm run verify:api",
    "verify:phase-b": "npm run verify:phase-a",
    "verify:phase-c": "npm run verify:phase-b && npx playwright test tests-e2e/phase-c-boundaries.spec.ts --reporter=list",
    "verify:phase-1": "npm run verify:phase-b && cross-env NODE_ENV=test jest --config jest.config.ts --maxWorkers=2 __tests__/api/lib/stripe-webhook-order-payments.test.ts __tests__/lib/vendor-staff-access.test.ts __tests__/payment/checkout.test.tsx && npx playwright test tests-e2e/phase-c-boundaries.spec.ts tests-e2e/phase1-money-api.spec.ts --reporter=list",
    "worker:stripe-webhook": "tsx workers/stripe-webhook-worker.ts",
    "verify:phase-2": "npm run verify:phase-1 && cross-env NODE_ENV=test jest --config jest.config.ts --maxWorkers=2 __tests__/lib/pos-sale-stock.test.ts && npx playwright test tests-e2e/phase2-vendor-erp.spec.ts --reporter=list",
    "verify:phase-3": "npm run verify:phase-2 && cross-env NODE_ENV=test jest --config jest.config.ts --maxWorkers=2 __tests__/lib/financial-audit.test.ts && npx playwright test tests-e2e/phase3-governance.spec.ts --reporter=list",
    "verify:phase-4": "node scripts/verify-admin-csrf.mjs && node scripts/verify-api-parity.mjs && node scripts/verify-money-no-test-skip.mjs && npm run verify:phase-3 && npx playwright test tests-e2e/phase4-leftovers.spec.ts --reporter=list",
    "verify:deploy-env": "node scripts/verify-deploy-env.mjs"
  },
  "dependencies": {
    "@albaz/ui": "file:./packages/ui",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-alert-dialog": "latest",
